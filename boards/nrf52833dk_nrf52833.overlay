/ {
    chosen {
        /* DTM 제어용 UART를 uart0(P0.15/P0.17)로 지정 */
        ncs,dtm-uart = &uart0;
    };
};

&uart0_default {
    /* Keep only TX/RX mapping used by DTM on P0.15/P0.17. */
    /delete-node/ group2;

    group1 {
        psels = <NRF_PSEL(UART_TX, 0, 15)>,
                <NRF_PSEL(UART_RX, 0, 17)>;
    };
};

&uart0_sleep {
    group1 {
        psels = <NRF_PSEL(UART_TX, 0, 15)>,
                <NRF_PSEL(UART_RX, 0, 17)>;
        low-power-enable;
    };
};

&uart0 {
    status = "okay";
    current-speed = <19200>;
    /delete-property/ hw-flow-control;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

&radio {
    /* Disable Direction Finding for this board build (no DFE GPIO map configured). */
    /delete-property/ dfe-supported;
};
